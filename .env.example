# Copy this file to .env (which git ignores) and fill in what you use.

# Optional. Route Amazon's browser through a proxy, as a full address:
#   AMAZON_PROXY=http://username:password@host:port
# Used by update-prices.bat, `npm run fill:amazon` and the dev server's
# re-check. Leave it unset to connect directly.
AMAZON_PROXY=
